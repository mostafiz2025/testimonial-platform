# ---------- server ----------
PORT=7000
FRONTEND_URL=http://localhost:5000
JWT_SECRET=change_this_to_a_long_random_secret

# ---------- database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=TestimonialDB
# true = tables are created/updated automatically (turn off in production)
DB_SYNC=true

# ---------- first admin (auto created on first start) ----------
ADMIN_EMAIL=admin@testimonial.local
ADMIN_PASSWORD=Admin@12345

# ---------- optional: e-mail alert when a new testimonial arrives ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
